int get_cluster_index(vec3 worldPos) {
    int nodeIdx = 0;
    
    // Safety cap to prevent GPU hangs
    for (int i = 0; i < 128; i++) {
        BspNode node = bspNodes[nodeIdx];
        
        // Check which side of the plane the point is on
        float dist = dot(worldPos, node.plane.xyz) - node.plane.w;
        int nextIndex = (dist >= 0.0) ? node.children[0] : node.children[1];
        
        if (nextIndex < 0) {
            // Decoded negative index points to the bspLeaves buffer
            int leafIndex = -1 - nextIndex;
            return bspLeaves[leafIndex];
        }
        
        // Move to the next decision node
        nodeIdx = nextIndex;
    }
    
    return -1; // Failed to find cluster (safety limit hit)
}

void initReservoir(out LocalReservoir r) {
    r.lightIndex = 0xFFFFFFFFu; // Invalid light ID
    r.M = 0u;
    r.weightSum = 0.0;
    r.W = 0.0;
    r.packedNormal = 0u;
    r.depth = 0.0;
    r.sampleUV = vec2(0.0);
}

bool updateReservoir(inout LocalReservoir r, uint lightIndex, float weight, float p_hat, float randVal, vec2 sampleUV) {
    r.weightSum += weight;
    r.M += 1u;
    float selectionProbability = (r.weightSum > 0.0) ? (weight / r.weightSum) : 0.0;
    if (randVal < selectionProbability) {
        r.lightIndex = lightIndex;
        r.sampleUV = sampleUV;
        return true;
    }
    return false;
}

bool combineReservoir(inout LocalReservoir r, uint lightIndex, float weight, uint M_new, float randVal, vec2 sampleUV) {
    r.weightSum += weight;
    r.M += M_new;
    float selectionProbability = (r.weightSum > 0.0) ? (weight / r.weightSum) : 0.0;
    if (randVal < selectionProbability) {
        r.lightIndex = lightIndex;
        r.sampleUV = sampleUV;
        return true;
    }
    return false;
}

uint getPixelIndex() {
    return uint(gl_FragCoord.y) * u_width + uint(gl_FragCoord.x);
}

void writeReservoir(uint pixelIdx, LocalReservoir lr) {
    Reservoir r;
    uint lightIdxClamped = (lr.lightIndex == 0xFFFFFFFFu) ? 0xFFFFu : (lr.lightIndex & 0xFFFFu);
    r.lightIndex_M = lightIdxClamped | (lr.M << 16u);
    r.packedSampleUV = packHalf2x16(lr.sampleUV);
    r.weightSum = lr.weightSum;
    r.W = lr.W;
    r.packedNormal = lr.packedNormal;
    r.depth = lr.depth;

    if (u_writeIndex == 0u) {
        reservoirs0[pixelIdx] = r;
    } else {
        reservoirs1[pixelIdx] = r;
    }
}

LocalReservoir readReservoir(uint pixelIdx) {
    Reservoir r;
    if (u_readIndex == 0u) {
        r = reservoirs0[pixelIdx];
    } else {
        r = reservoirs1[pixelIdx];
    }
    
    LocalReservoir lr;
    uint y = r.lightIndex_M & 0xFFFFu;
    lr.lightIndex = (y == 0xFFFFu) ? 0xFFFFFFFFu : y;
    lr.M = r.lightIndex_M >> 16u;
    lr.sampleUV = clamp(unpackHalf2x16(r.packedSampleUV), 0.0, 1.0);
    lr.weightSum = r.weightSum;
    lr.W = r.W;
    lr.packedNormal = r.packedNormal;
    lr.depth = r.depth;
    return lr;
}

// Trace a shadow ray from worldPos toward lightPos against the world TLAS.
// Returns 1.0 if the light is visible (unoccluded), 0.0 if something blocks it.
float traceShadow(vec3 worldPos, vec3 lightPos) {
    vec3 toLight = lightPos - worldPos;
    float dist = length(toLight);
    vec3 dir = toLight / dist;

    rayQueryEXT rq;
    // TerminateOnFirstHit: we only care whether ANYTHING blocks, not the closest hit.
    // tMin 1.0 / tMax dist-1.0: bias off the surface and stop just short of the light.
    rayQueryInitializeEXT(rq, u_tlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xFFu, worldPos, 1.0, dir, dist - 1.0);

    while (rayQueryProceedEXT(rq)) {}

    return (rayQueryGetIntersectionTypeEXT(rq, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
}

