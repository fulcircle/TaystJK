float eval_p_hat(uint lightIndex, vec3 pos, vec3 normal) {
    if (lightIndex == 0xFFFFFFFFu || lightIndex >= u_numLights) {
        return 0.0;
    }
    vec3 toLight = vec3(lights[lightIndex].lightCentroid[0], lights[lightIndex].lightCentroid[1], lights[lightIndex].lightCentroid[2]) - pos;
    float distSq = dot(toLight, toLight);
    float dist = sqrt(distSq);
    float NdotL = max(dot(normal, toLight / max(dist, 0.001)), 0.0);
    float falloff = u_falloffScale / max(distSq, 1024.0);
    vec3 lcolor = vec3(lights[lightIndex].color[0], lights[lightIndex].color[1], lights[lightIndex].color[2]) * u_surfaceLightScale;
    return max(lcolor.r, max(lcolor.g, lcolor.b)) * falloff * NdotL;
}

